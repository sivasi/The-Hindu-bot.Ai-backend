# Secrets for Google GIS + app JWT (+ Mongo). Do NOT commit real values.
# Auth mode: GIS idToken only — NO backend redirect URI (Google rejects IP URIs).
#
# kubectl create secret generic rag-api-secrets \
#   --from-literal=JWT_SECRET="$(openssl rand -hex 32)" \
#   --from-literal=GOOGLE_CLIENT_ID="YOUR_CLIENT_ID.apps.googleusercontent.com" \
#   --from-literal=AUTH_REQUIRED="true" \
#   --from-literal=MONGODB_URI="mongodb://mongo:27017/rag_users"
#
apiVersion: v1
kind: Secret
metadata:
  name: rag-api-secrets
  labels:
    app: rag-api
type: Opaque
stringData:
  JWT_SECRET: "REPLACE_WITH_LONG_RANDOM_SECRET"
  GOOGLE_CLIENT_ID: "REPLACE.apps.googleusercontent.com"
  AUTH_REQUIRED: "true"
  JWT_EXPIRES_IN: "7d"
  MONGODB_URI: "mongodb://mongo:27017/rag_users"
