# Vertex AI (uses GCP billing — no AI Studio API key needed)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-south1

# Chat (use global if model is not in asia-south1)
CHAT_MODEL=gemini-2.5-flash
CHAT_LOCATION=asia-south1

# Express API
PORT=3001
CORS_ORIGIN=*
RETRIEVER_K=3
TURBO_RETRIEVER_K=10

# Auth: run `gcloud auth application-default login`

# Local only — production overrides these in k8s (cluster Chroma + Mongo).
# Chroma + BM25: same newspaper stack as RAG/8.2026-data (ports 8001 / 8002).
CHROMA_URL=http://localhost:8001
CHROMA_COLLECTION=newspapers_2026
LEXICAL_INDEX_URL=http://localhost:8002/lexical-index.json
PDF_DIR=C:/Users/adity/Downloads/The-Hindu-pdfs
# Mongo: docker compose up -d  → hindubot-mongo with named volume
MONGODB_URI=mongodb://127.0.0.1:27017/rag_users
