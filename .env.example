# Vertex AI (uses GCP billing — no AI Studio API key needed)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-south1

# Chat (use global if model is not in asia-south1)
CHAT_MODEL=gemini-2.5-flash
CHAT_LOCATION=asia-south1

# Express API
PORT=3001
CORS_ORIGIN=*
RETRIEVER_K=3
TURBO_RETRIEVER_K=10

# Auth: run `gcloud auth application-default login`

# Chroma vector DB (start with: docker compose up -d)
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=manual4_pdf
